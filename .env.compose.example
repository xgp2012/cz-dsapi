# ---------------------------------------------------------------------------
# docker-compose.yml 的配套变量文件
#
# 用法：复制为 .env（与 docker-compose.yml 同目录），填好下面两项，然后
#   docker compose up -d
#
# Docker Compose 会自动读取同目录的 .env，不需要 -f 或 --env-file。
# 这就是为什么 API_KEY / token 不直接写在 compose 里：既能避免提交到 git，
# 也能让「改配置」不用动 compose 文件本身。
#
# ⚠️ 本文件不要提交到版本库（项目的 .gitignore 已忽略 .env）
# ---------------------------------------------------------------------------

# ------------------------------ 必填 ------------------------------
# 访问 API 和控制台都要用它。生成一个强随机串：
#   openssl rand -hex 24
# 或 PowerShell：
#   -join ((1..48) | % { '{0:x}' -f (Get-Random -Max 16) })
#
# 容器默认监听 0.0.0.0，留空 = 任何能访问该端口的人都能白嫖你的号池。
CZ_API_KEY=

# --------------------------- 登录态（可选） ---------------------------
# 二选一即可；两个都留空也能启动，首次打开控制台时会引导你粘贴。
#
# 单个账号：
CZ_USER_TOKEN=

# 号池（多账号轮换，抗限流）：空格或逗号分隔
# 例：CZ_USER_TOKENS=token1 token2 token3
CZ_USER_TOKENS=
