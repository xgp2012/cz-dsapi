# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改（所有值都有默认值，只有 token 是必须的）
# ---------------------------------------------------------------------------

# 数据目录（token、设备 ID、日志、截图产物都放这里）
# DATA_DIR=data

# DeepSeek 网页登录态。推荐用 `npm run auth -- <userToken>` 写入 data/auth.json，
# 而不是把 token 放在这里。
# 号池：多个 token 用空格/逗号分隔（推荐写进 data/auth.json：npm run auth -- t1 t2）
# DEEPSEEK_USER_TOKENS=
# DEEPSEEK_USER_TOKEN=
# 引擎：direct（默认，直连网页接口 + Go 解 PoW，最快）| browser（Playwright 驱动真实网页，不依赖 PoW）| auto（有 ds-pow 就直连）
ENGINE=direct
# Go PoW 求解器。Windows 上 `npm run pow:build` 产出 bin/ds-pow.exe；
# 这里写 bin/ds-pow 也能用 —— 启动时会自动按 PATHEXT 补 .exe（见 src/util.mjs）
POW_BIN=bin/ds-pow
# PoW 求解器每个任务的并行 goroutine 数。留空/0 = 用 CPU 核数。
# 高并发时可以调小：N 个并发求解各起「核数」个 goroutine 会互相抢核，
# 实测并发 8 时每任务 2 个 worker 反而比 4 个更快收敛。
# POW_WORKERS=2
# 每个账号同时在途的请求上限（号池多号时把并发摊开，避免全压一个号撞风控）。0=不限
# MAX_INFLIGHT_PER_ACCOUNT=2
# 设为任意值可关掉 ARMv8.2 SHA3 汇编 Keccak，回退纯 Go（正常情况下不需要）
# POW_NO_NEON=1
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# 深度思考：always（默认，打开网页上的「深度思考」）| auto（按模型名）| never
# 请求体里传 "thinking": false 可以单次关闭
DEEPSEEK_THINKING=always
# 智能搜索：默认关闭
DEEPSEEK_SEARCH=false
# 是否主动把网页上的「深度思考 / 智能搜索」开关拨到请求要求的状态
DEEPSEEK_MANAGE_TOGGLES=true
DEFAULT_MODEL=deepseek-flash

# ---------------------- 浏览器特征（直连模式） ----------------------
# 设备画像：chrome-win（桌面 Chrome）| chrome-android（移动 Chrome）
# 选定后请长期固定，不要来回切换，否则请求中的 UA / 平台会在不同时间跳变
DEEPSEEK_DEVICE_PROFILE=chrome-win
# 冷启动序列：启动时先拉配置、校验设备、回执配置，让账号有「网页打开过」的痕迹
DEEPSEEK_COLD_START=true
# 行为时序：把 PoW 求解耗时补到接近真浏览器 JS 的水平，并在发送前加随机停顿
DEEPSEEK_HUMAN_TIMING=true

# ---------------------------- 服务 ----------------------------
HOST=127.0.0.1
PORT=8787
# 设置后，客户端必须带 Authorization: Bearer <API_KEY>
# ⚠️ 把 HOST 改成 0.0.0.0 对外暴露时，请务必设置 API_KEY，否则任何人都能用你的号池
API_KEY=
CORS_ORIGIN=*
# 入口限流（按客户端 IP 的令牌桶）。号池冷却是「上游拒了才冷却」，
# 这一层是流量还没打到 DeepSeek 就先挡住，防止被当成免费代理刷爆账号。
RATE_LIMIT_ENABLED=true
# 每分钟允许的突发请求数（稳态每秒补 1 个令牌）
RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_REFILL_PER_SEC=1
# RATE_LIMIT_MAX_BUCKETS=10000
# 反向代理场景：不设时只认 socket 地址（客户端伪造 X-Forwarded-For 无效）。
# loopback = 只有直连方是本地/私网时才信任 X-Forwarded-For（推荐给本地 nginx）。
# 设成 1 表示无条件信任该头（只在代理完全可控时用）。
# TRUST_PROXY=loopback
LOG_LEVEL=info

# ---------------------------- 浏览器 ----------------------------
BROWSER_HEADLESS=true
# BROWSER_USER_AGENT=...
# CHROMIUM_EXECUTABLE=/path/to/chrome
# 无 root 环境下解包出来的依赖库目录
CHROMIUM_DEPS_DIR=~/.local/chromium-deps
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900
BROWSER_LOCALE=zh-CN
# 额外的 Chromium 启动参数（空格分隔），比如 --proxy-server=http://127.0.0.1:7890
# BROWSER_ARGS=
# 页面导航超时（毫秒）
# BROWSER_NAV_TIMEOUT_MS=60000
# 每步操作的人为减速（毫秒，调试时用）
# BROWSER_SLOW_MO=0

# ---------------------------- 运行 ----------------------------
# 同时跑几个浏览器页面（每个请求占一个页面，手机/小内存建议 1）
CONCURRENCY=1
QUEUE_LIMIT=64
REQUEST_TIMEOUT_MS=240000
FIRST_TOKEN_TIMEOUT_MS=90000
POLL_INTERVAL_MS=60
SETTLE_MS=800
# 两次发送的最小间隔与触发「发送过于频繁」后的退避
SEND_INTERVAL_MS=4000
# 直连引擎的发送间隔（网页接口没有浏览器那么严，可以更快）
DIRECT_SEND_INTERVAL_MS=0
# 某个账号被限流后的冷却时间，以及请求最多愿意等多久（超过就返回 429）
ACCOUNT_COOLDOWN_MS=60000
MAX_COOLDOWN_WAIT_MS=5000
# 账号后台探活：每隔多久复检一个「停用 / 冷却中」的账号（毫秒，0 = 关闭）。
# 探活只走「预建会话」，不消耗消息额度，也不和正常流量抢号；通过就自动恢复。
# token 失效的号不再需要人工重启进程，这一项就是那个自动路径。最小 60000。
ACCOUNT_PROBE_INTERVAL_MS=600000
# 优雅关闭最多等多久（毫秒），超时强制退出。
# docker stop 默认只给 10s，超过就被 SIGKILL（子进程会变孤儿），所以默认 8s。
SHUTDOWN_TIMEOUT_MS=8000
REASONING_HOLD_MS=900
RATE_LIMIT_BACKOFF_MS=4000
# 空闲多久关闭浏览器释放内存（0 = 不关闭）
IDLE_SHUTDOWN_MS=900000
# 启动时预热浏览器（省掉第一次请求的 2~3 秒）
WARMUP=true
# 浏览器模式：抓页面自己发出的补全接口原始流，用模型原始输出（含工具调用 token）当权威文本，
# DOM 只负责流式展示。关掉退回纯 DOM 提取（偶发丢工具调用的风险变高）。
BROWSER_CAPTURE=true
# DOM 提前判定结束时，最多再等原始流收尾多久（毫秒），用来补齐被截断的尾部 token
BROWSER_CAPTURE_WAIT_MS=20000
# 模型自己编造工具结果（RESULT）时，非流式请求带着更硬的约束重试一次
# 检测到模型自己写 RESULT / 伪造段落标题时，立即中止生成并先返回已拿到的正文和工具调用
# （模型编造结果后会继续长篇续写，不早停会让请求一直卡到超时）
# 网页输入框单次上限；超过就把较早的对话拆成 .txt 附件（ref_file_ids）注入
MAX_PROMPT_CHARS=100000
# 拆到附件的上下文最多多少字符
MAX_ATTACHMENT_CHARS=2000000
# 关掉则恢复旧行为：超长直接返回 413（浏览器引擎不支持附件，只能直连）
OVERFLOW_TO_ATTACHMENT=true
SAVE_ARTIFACTS=true
